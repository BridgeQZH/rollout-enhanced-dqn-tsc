<?xml version="1.0" encoding="UTF-8"?>

<!-- 2x2 grid configuration (Phase 2.3 multi-agent).
     The route file is regenerated each episode by GridODRoutes and is gitignored;
     paths are resolved relative to this .sumocfg file. -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="grid2x2.net.xml" />
        <route-files value="grid2x2_routes.rou.xml" />
    </input>

    <time>
        <begin value="0" />
    </time>

    <processing>
        <time-to-teleport value="-1" />
    </processing>

</configuration>
