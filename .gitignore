# ===========================================================================
# Rollout-Enhanced DQN for Traffic Signal Control — .gitignore
# ===========================================================================

# --- Python bytecode / caches ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Virtual environments (never commit; recreate from requirements.txt) ----
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
academic_artifacts/

# --- Editors / OS junk ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Testing / coverage / notebooks ----------------------------------------
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
deck/
docs/
models/
rollout_tlcs.egg-info/
# --- SUMO dynamic outputs (regenerated every run) --------------------------
# Route files are always rewritten by Environment.generate_routefile();
# the network (.net.xml) and config (.sumocfg) are source and stay tracked.
*.rou.xml
# Common SUMO run artifacts / logs
*.tripinfo.xml
*.summary.xml
*.out.xml
sumo*.log
*.stdout
*.stderr

# --- ffmpeg two-pass logs ---------------------------------------------------
ffmpeg2pass*.log
*.mbtree

# --- Video media ------------------------------------------------------------
# Ignore all heavy raw recordings, but DO track the curated <50MB demo clip.
*.mp4
*.mkv
*.mov
*.webm
!media/final_comparison.mp4

# --- Misc local scratch -----------------------------------------------------
*.tmp
*.bak
*.log
